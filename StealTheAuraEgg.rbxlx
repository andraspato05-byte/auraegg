          <string name="Name">Config</string>
          <string name="Source"><![CDATA[--[[
	Config (ReplicatedStorage.Shared.Config)

	Every tunable setting for Steal the Aura Egg lives here, plus the full
	list of Aura Eggs. Shared by the server and the client.
]]

local Config = {}

Config.GameName = "Steal the Aura Egg"

-- Economy -------------------------------------------------------------------
Config.StartingCash = 100
Config.SellMultiplier = 0.5 -- selling an egg refunds this fraction of its price

-- Bases ---------------------------------------------------------------------
Config.MaxPlots = 8 -- the map has room for exactly 8 bases (set Max Players to 8)
Config.SlotsPerPlot = 10 -- the base layout has exactly 10 pedestals
Config.LockDuration = 60 -- seconds a base stays locked
Config.LockCooldown = 10 -- seconds after a lock ends before it can be locked again

-- Conveyor belt -------------------------------------------------------------
Config.BeltSpeed = 7 -- studs per second
Config.BeltSpawnInterval = 2.5 -- seconds between new eggs
Config.BeltMaxEggs = 40
Config.AnnounceRarityIndex = 5 -- announce eggs of this rarity index or higher (5 = Legendary)

-- Stealing ------------------------------------------------------------------
Config.StealHoldDuration = 1.5
Config.CarryWalkSpeed = 11
Config.NormalWalkSpeed = 16

-- AURA STORM event -------------------------------------------------------------
-- A purple lightning storm. While it lasts, eggs come out of the machine faster,
-- rare eggs are much more likely, and some eggs come out Storm-charged.
Config.Event = {
	Name = "AURA STORM",
	FirstDelay = 180, -- seconds after the server starts until the first storm
	Interval = 900, -- seconds between the start of one storm and the next
	Duration = 240, -- seconds a storm lasts
	WarningTime = 30, -- announce this many seconds before it starts
	SpawnIntervalMultiplier = 0.5, -- eggs come out twice as fast
	RareLuck = 3, -- Rare and better eggs are 3x more likely
	StormChance = 0.3, -- chance an egg comes out Storm-charged
}

-- Mutations are saved with the egg ("DragonAura:Storm") and change its value.
Config.Mutations = {
	Storm = {
		Name = "Storm",
		IncomeMultiplier = 3,
		PriceMultiplier = 2.5,
		Color = Color3.fromRGB(110, 200, 255),
	},
}

-- Animals (hatched eggs) ------------------------------------------------------
Config.PetIncomeMultiplier = 2 -- a hatched animal earns 2x what its egg did
Config.PetValueMultiplier = 2 -- and is worth 2x when sold
Config.MutationSizeMultiplier = 1.5 -- Storm animals make you grow 1.5x more

-- Size + MOG -------------------------------------------------------------------
-- Every hatched animal on your base makes you bigger (see Rarities.SizeBonus).
-- Stand next to a smaller player and press MOG (or G) to send them flying.
Config.MaxScale = 2.5 -- biggest a player can get (2.5x normal size)
Config.MogRange = 12 -- studs (grows with your size)
Config.MogMinLead = 0.1 -- you must be at least this much bigger than the target
Config.MogCooldown = 8 -- seconds between your MOGs
Config.MogImmunity = 6 -- seconds a mogged player can't be mogged again
Config.MogRewardSeconds = 5 -- reward = 5 seconds of the target's income...
Config.MogMinReward = 25 -- ...but at least this much

-- Base upgrades ----------------------------------------------------------------
-- Use the UPGRADE terminal inside your base. Slots = unlocked pedestals.
-- CashBonus 0.25 = +25% cash from everything on your base. LockBonus = extra lock seconds.
Config.BaseUpgrades = {
	{ Level = 1, Cost = 0, Slots = 4, CashBonus = 0, LockBonus = 0 },
	{ Level = 2, Cost = 300, Slots = 6, CashBonus = 0, LockBonus = 0 },
	{ Level = 3, Cost = 3000, Slots = 8, CashBonus = 0, LockBonus = 0 },
	{ Level = 4, Cost = 30000, Slots = 10, CashBonus = 0, LockBonus = 0 },
	{ Level = 5, Cost = 300000, Slots = 10, CashBonus = 0.25, LockBonus = 0 },
	{ Level = 6, Cost = 3000000, Slots = 10, CashBonus = 0.5, LockBonus = 30 },
	{ Level = 7, Cost = 30000000, Slots = 10, CashBonus = 1, LockBonus = 30 },
}

-- Speed + treadmills ----------------------------------------------------------
-- Running on a treadmill in the gym earns Speed points.
-- Walk speed = NormalWalkSpeed + Speed * SpeedPerPoint (max MaxSpeed points).
Config.SpeedPerPoint = 0.05 -- 20 Speed = +1 walk speed
Config.MaxSpeed = 500 -- 500 Speed = 16 + 25 = 41 walk speed
Config.CarrySpeedFactor = 0.7 -- carrying an egg slows you to 70% (never below CarryWalkSpeed)
-- PushSpeed = how fast the belt pushes you back (studs/s). You need to run faster than it.
Config.Treadmills = {
	{ Tier = 1, Rate = 1, Required = 0, PushSpeed = 6 },
	{ Tier = 2, Rate = 2, Required = 100, PushSpeed = 12 },
	{ Tier = 3, Rate = 4, Required = 250, PushSpeed = 18 },
	{ Tier = 4, Rate = 8, Required = 400, PushSpeed = 24 },
}

function Config.GetWalkSpeed(speedPoints)
	local points = math.clamp(math.floor(speedPoints or 0), 0, Config.MaxSpeed)
	return Config.NormalWalkSpeed + points * Config.SpeedPerPoint
end

-- Bat -----------------------------------------------------------------------
Config.BatName = "Aura Bat"
Config.BatCooldown = 0.9
Config.BatRange = 9
Config.BatKnockback = 55

-- Saving --------------------------------------------------------------------
Config.DataStoreName = "StealTheAuraEgg_v1"
Config.AutosaveInterval = 120

-- Robux shop -------------------------------------------------------------------
-- Create these on the Creator Dashboard (create.roblox.com > your game >
-- Monetization > Passes / Developer Products) and paste each ID below.
-- An item with Id = 0 shows as "Not set up" in the shop and can't be bought.
Config.GamePasses = {
	{ Key = "DoubleCash", Id = 0, Name = "2x Cash", Description = "Every egg on your base makes double cash." },
	{ Key = "FastCarry", Id = 0, Name = "Speedy Thief", Description = "No slowdown while carrying a stolen egg." },
	{ Key = "LongLock", Id = 0, Name = "Mega Lock", Description = "Your base stays locked twice as long." },
}

Config.Products = {
	{ Key = "CashSmall", Id = 0, Name = "Pile of Cash", Cash = 10000 },
	{ Key = "CashMedium", Id = 0, Name = "Bag of Cash", Cash = 250000 },
	{ Key = "CashLarge", Id = 0, Name = "Vault of Cash", Cash = 5000000 },
	{ Key = "LuckyEgg", Id = 0, Name = "Lucky Aura Egg", LuckyEgg = true },
}

Config.LuckyEggMinRarity = 5 -- Lucky Aura Egg gives Legendary (5) or better
Config.DoubleCashMultiplier = 2
Config.LongLockMultiplier = 2

-- Rarities (Weight = how often this rarity appears on the belt) -------------
-- HatchTime = seconds on your base before the egg hatches into its animal.
-- SizeBonus = how much bigger each hatched animal makes its owner (1 = normal size).
Config.Rarities = {
	{ Name = "Common", Color = Color3.fromRGB(200, 200, 200), Weight = 50, HatchTime = 60, SizeBonus = 0.04 },
	{ Name = "Uncommon", Color = Color3.fromRGB(90, 225, 100), Weight = 26, HatchTime = 90, SizeBonus = 0.06 },
	{ Name = "Rare", Color = Color3.fromRGB(60, 150, 255), Weight = 13, HatchTime = 120, SizeBonus = 0.09 },
	{ Name = "Epic", Color = Color3.fromRGB(180, 85, 255), Weight = 6.5, HatchTime = 180, SizeBonus = 0.13 },
	{ Name = "Legendary", Color = Color3.fromRGB(255, 195, 40), Weight = 3, HatchTime = 240, SizeBonus = 0.18 },
	{ Name = "Mythic", Color = Color3.fromRGB(255, 60, 115), Weight = 1.2, HatchTime = 300, SizeBonus = 0.25 },
	{ Name = "Secret", Color = Color3.fromRGB(255, 255, 255), Weight = 0.3, HatchTime = 420, SizeBonus = 0.35 }, -- rainbow
}

-- Aura Eggs -----------------------------------------------------------------
-- Price = cost on the belt, Income = cash per second while it sits on your base
-- PetName / PetShape = the animal that hatches out of it (shapes: Bunny, Bear, Frog, Cat, Fox, Bird, Dragon)
Config.Eggs = {
	-- Common
	{ Id = "DustyAura", Name = "Dusty Aura Egg", Rarity = "Common", Price = 25, Income = 1, PetName = "Dust Bunny", PetShape = "Bunny",
		EggColor = Color3.fromRGB(214, 200, 175), AuraColor = Color3.fromRGB(255, 245, 220) },
	{ Id = "PebbleAura", Name = "Pebble Aura Egg", Rarity = "Common", Price = 40, Income = 2, PetName = "Pebble Bear", PetShape = "Bear",
		EggColor = Color3.fromRGB(150, 150, 155), AuraColor = Color3.fromRGB(225, 225, 230) },
	{ Id = "LeafyAura", Name = "Leafy Aura Egg", Rarity = "Common", Price = 60, Income = 3, PetName = "Leaf Frog", PetShape = "Frog",
		EggColor = Color3.fromRGB(110, 190, 90), AuraColor = Color3.fromRGB(180, 255, 160) },

	-- Uncommon
	{ Id = "BubbleAura", Name = "Bubble Aura Egg", Rarity = "Uncommon", Price = 150, Income = 6, PetName = "Bubble Cat", PetShape = "Cat",
		EggColor = Color3.fromRGB(140, 210, 255), AuraColor = Color3.fromRGB(205, 240, 255) },
	{ Id = "EmberAura", Name = "Ember Aura Egg", Rarity = "Uncommon", Price = 250, Income = 10, PetName = "Ember Fox", PetShape = "Fox",
		EggColor = Color3.fromRGB(240, 110, 50), AuraColor = Color3.fromRGB(255, 190, 90) },
	{ Id = "MintyAura", Name = "Minty Aura Egg", Rarity = "Uncommon", Price = 400, Income = 15, PetName = "Mint Bunny", PetShape = "Bunny",
		EggColor = Color3.fromRGB(150, 245, 200), AuraColor = Color3.fromRGB(110, 255, 190) },

	-- Rare
	{ Id = "FrostAura", Name = "Frost Aura Egg", Rarity = "Rare", Price = 1000, Income = 35, PetName = "Frost Bear", PetShape = "Bear",
		EggColor = Color3.fromRGB(200, 235, 255), AuraColor = Color3.fromRGB(120, 210, 255) },
	{ Id = "ThunderAura", Name = "Thunder Aura Egg", Rarity = "Rare", Price = 1800, Income = 60, PetName = "Thunder Bird", PetShape = "Bird",
		EggColor = Color3.fromRGB(255, 230, 70), AuraColor = Color3.fromRGB(255, 255, 140) },
	{ Id = "OceanAura", Name = "Ocean Aura Egg", Rarity = "Rare", Price = 3000, Income = 95, PetName = "Tide Frog", PetShape = "Frog",
		EggColor = Color3.fromRGB(30, 110, 200), AuraColor = Color3.fromRGB(60, 200, 255) },

	-- Epic
	{ Id = "ShadowAura", Name = "Shadow Aura Egg", Rarity = "Epic", Price = 8000, Income = 230, PetName = "Shadow Cat", PetShape = "Cat",
		EggColor = Color3.fromRGB(45, 35, 60), AuraColor = Color3.fromRGB(150, 70, 255) },
	{ Id = "CrystalAura", Name = "Crystal Aura Egg", Rarity = "Epic", Price = 14000, Income = 380, PetName = "Crystal Fox", PetShape = "Fox",
		EggColor = Color3.fromRGB(235, 170, 255), AuraColor = Color3.fromRGB(255, 140, 255) },
	{ Id = "VoidAura", Name = "Void Aura Egg", Rarity = "Epic", Price = 25000, Income = 650, PetName = "Void Raven", PetShape = "Bird",
		EggColor = Color3.fromRGB(15, 10, 25), AuraColor = Color3.fromRGB(110, 40, 200) },

	-- Legendary
	{ Id = "SolarAura", Name = "Solar Aura Egg", Rarity = "Legendary", Price = 60000, Income = 1500, PetName = "Solar Lion", PetShape = "Cat",
		EggColor = Color3.fromRGB(255, 170, 30), AuraColor = Color3.fromRGB(255, 220, 80) },
	{ Id = "DragonAura", Name = "Dragon Aura Egg", Rarity = "Legendary", Price = 110000, Income = 2600, PetName = "Fire Dragon", PetShape = "Dragon",
		EggColor = Color3.fromRGB(170, 25, 25), AuraColor = Color3.fromRGB(255, 90, 30) },
	{ Id = "CosmicAura", Name = "Cosmic Aura Egg", Rarity = "Legendary", Price = 200000, Income = 4500, PetName = "Cosmic Fox", PetShape = "Fox",
		EggColor = Color3.fromRGB(40, 30, 110), AuraColor = Color3.fromRGB(120, 160, 255) },

	-- Mythic
	{ Id = "PhoenixAura", Name = "Phoenix Aura Egg", Rarity = "Mythic", Price = 600000, Income = 12000, PetName = "Phoenix", PetShape = "Bird",
		EggColor = Color3.fromRGB(255, 90, 20), AuraColor = Color3.fromRGB(255, 200, 40) },
	{ Id = "GalaxyAura", Name = "Galaxy Aura Egg", Rarity = "Mythic", Price = 1200000, Income = 22000, PetName = "Galaxy Dragon", PetShape = "Dragon",
		EggColor = Color3.fromRGB(70, 20, 120), AuraColor = Color3.fromRGB(255, 80, 200) },

	-- Secret
	{ Id = "RainbowAura", Name = "Rainbow Aura Egg", Rarity = "Secret", Price = 5000000, Income = 80000, PetName = "Rainbow Dragon", PetShape = "Dragon",
		EggColor = Color3.fromRGB(255, 255, 255), AuraColor = Color3.fromRGB(255, 255, 255) },
	{ Id = "OmegaAura", Name = "Omega Aura Egg", Rarity = "Secret", Price = 15000000, Income = 220000, PetName = "Omega Dragon King", PetShape = "Dragon",
		EggColor = Color3.fromRGB(10, 10, 10), AuraColor = Color3.fromRGB(255, 255, 255) },
}

-- Lookup tables ---------------------------------------------------------------
Config.RarityByName = {}
for index, rarity in Config.Rarities do
	rarity.Index = index
	Config.RarityByName[rarity.Name] = rarity
end

Config.EggById = {}
Config.EggsByRarity = {}
for _, egg in Config.Eggs do
	assert(Config.RarityByName[egg.Rarity], "Egg " .. egg.Id .. " has an unknown rarity: " .. egg.Rarity)
	assert(Config.EggById[egg.Id] == nil, "Duplicate egg id: " .. egg.Id)
	Config.EggById[egg.Id] = egg
	local list = Config.EggsByRarity[egg.Rarity]
	if not list then
		list = {}
		Config.EggsByRarity[egg.Rarity] = list
	end
	table.insert(list, egg)
end

function Config.GetEgg(eggId)
	return Config.EggById[eggId]
end

function Config.GetRarity(rarityName)
	return Config.RarityByName[rarityName]
end

-- Picks a random egg id using the rarity weights.
-- minRarityIndex (optional) skips rarities below it, e.g. 5 = Legendary or better.
-- rareLuck (optional) multiplies the weight of Rare (index 3) and better.
function Config.RollEggId(rng, minRarityIndex, rareLuck)
	local minIndex = minRarityIndex or 1
	local luck = rareLuck or 1
	local function weightOf(rarity)
		return rarity.Index >= 3 and rarity.Weight * luck or rarity.Weight
	end

	local total = 0
	for _, rarity in Config.Rarities do
		if rarity.Index >= minIndex and Config.EggsByRarity[rarity.Name] then
			total += weightOf(rarity)
		end
	end

	local roll = rng:NextNumber() * total
	for _, rarity in Config.Rarities do
		local list = Config.EggsByRarity[rarity.Name]
		if rarity.Index >= minIndex and list then
			roll -= weightOf(rarity)
			if roll <= 0 then
				return list[rng:NextInteger(1, #list)].Id
			end
		end
	end

	-- floating point leftovers: return the last eligible egg
	for index = #Config.Eggs, 1, -1 do
		local egg = Config.Eggs[index]
		if Config.GetRarity(egg.Rarity).Index >= minIndex then
			return egg.Id
		end
	end
	return Config.Eggs[1].Id
end

-- Egg / animal helpers -----------------------------------------------------------
-- Every item on a pedestal is an egg id, an optional mutation (e.g. "Storm") and
-- whether it has hatched into its animal yet.

function Config.GetMutation(mutationName)
	if mutationName == nil then
		return nil
	end
	return Config.Mutations[mutationName]
end

function Config.GetHatchTime(eggId)
	local def = Config.GetEgg(eggId)
	if not def then
		return 60
	end
	return Config.GetRarity(def.Rarity).HatchTime
end

function Config.GetEggIncome(eggId, mutationName, hatched)
	local def = Config.GetEgg(eggId)
	if not def then
		return 0
	end
	local mutation = Config.GetMutation(mutationName)
	local income = def.Income * (mutation and mutation.IncomeMultiplier or 1)
	if hatched then
		income *= Config.PetIncomeMultiplier
	end
	return income
end

function Config.GetEggPrice(eggId, mutationName, hatched)
	local def = Config.GetEgg(eggId)
	if not def then
		return 0
	end
	local mutation = Config.GetMutation(mutationName)
	local price = def.Price * (mutation and mutation.PriceMultiplier or 1)
	if hatched then
		price *= Config.PetValueMultiplier
	end
	return math.floor(price)
end

function Config.GetEggDisplayName(eggId, mutationName, hatched)
	local def = Config.GetEgg(eggId)
	local name = def and (hatched and def.PetName or def.Name) or tostring(eggId)
	local mutation = Config.GetMutation(mutationName)
	if mutation then
		return mutation.Name .. " " .. name
	end
	return name
end

-- How much bigger a hatched animal makes its owner (eggs give nothing).
function Config.GetSizeBonus(eggId, mutationName, hatched)
	local def = Config.GetEgg(eggId)
	if not def or not hatched then
		return 0
	end
	local bonus = Config.GetRarity(def.Rarity).SizeBonus
	if Config.GetMutation(mutationName) then
		bonus *= Config.MutationSizeMultiplier
	end
	return bonus
end

-- Saved form of an item: { Id = "DragonAura", M = "Storm", P = true } for a hatched
-- animal, or { Id = "DragonAura", T = 120 } for an egg with 120 seconds left.
function Config.EncodeEgg(eggId, mutationName, hatched, hatchLeft)
	return {
		Id = eggId,
		M = mutationName,
		P = hatched and true or nil,
		T = (not hatched) and math.max(0, math.floor(hatchLeft or Config.GetHatchTime(eggId))) or nil,
	}
end

-- Accepts a saved item (table, or the older "EggId" / "EggId:Mutation" text).
-- Returns eggId, mutationName, hatched, hatchLeft; eggId is nil if it isn't valid.
function Config.DecodeEgg(saved)
	local eggId, mutationName, hatched, hatchLeft
	if type(saved) == "string" then
		eggId, mutationName = string.match(saved, "^([^:]+):([^:]+)$")
		if not eggId then
			eggId = saved
			mutationName = nil
		end
	elseif type(saved) == "table" then
		eggId = saved.Id
		mutationName = saved.M
		hatched = saved.P == true
		hatchLeft = saved.T
	end

	if type(eggId) ~= "string" or not Config.GetEgg(eggId) then
		return nil, nil, false, 0
	end
	if type(mutationName) ~= "string" or not Config.Mutations[mutationName] then
		mutationName = nil -- unknown mutation: keep the egg, drop the mutation
	end
	hatched = hatched == true
	local fullTime = Config.GetHatchTime(eggId)
	if type(hatchLeft) ~= "number" or hatchLeft ~= hatchLeft then
		hatchLeft = fullTime
	end
	hatchLeft = math.clamp(math.floor(hatchLeft), 0, fullTime)
	return eggId, mutationName, hatched, hatchLeft
end

function Config.GetBaseLevel(level)
	local index = math.clamp(math.floor(level or 1), 1, #Config.BaseUpgrades)
	return Config.BaseUpgrades[index]
end

local SUFFIXES = { "", "K", "M", "B", "T", "Qa", "Qi", "Sx" }

-- 1234 -> "1.2K", 5000000 -> "5M"
function Config.FormatNumber(value)
	local n = math.floor(value)
	local v = math.abs(n)
	local index = 1
	while v >= 1000 and index < #SUFFIXES do
		v /= 1000
		index += 1
	end

	local text
	if index == 1 then
		text = tostring(math.floor(v))
	else
		text = string.format("%.1f", math.floor(v * 10) / 10)
		text = string.gsub(text, "%.0$", "")
	end

	if n < 0 then
		text = "-" .. text
	end
	return text .. SUFFIXES[index]
end

function Config.FormatCash(value)
	return "$" .. Config.FormatNumber(value)
end

return Config
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="6">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="7">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">BatService</string>
          <string name="Source"><![CDATA[--[[
	BatService
	Every player gets an Aura Bat. Swinging it at a player knocks them back,
	and if they are carrying a stolen egg they drop it (it goes home).
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local StarterPack = game:GetService("StarterPack")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Remotes = require(script.Parent.Remotes)
local PlotService = require(script.Parent.PlotService)

local BatService = {}

local GRIP_DISTANCE = 1.6 -- hold the bat near its back end (studs at normal size)

local function restGrip(scale)
	return CFrame.new(0, 0, GRIP_DISTANCE * scale)
end

local function swingGrip(scale)
	return CFrame.new(0, 0, GRIP_DISTANCE * scale) * CFrame.Angles(math.rad(-75), 0, 0)
end

local template = nil
local lastSwing = {} -- [Player] = time of last swing
local hookedTools = setmetatable({}, { __mode = "k" })

local function buildBat(scale)
	local tool = Instance.new("Tool")
	tool:SetAttribute("Scale", scale)
	tool.Name = Config.BatName
	tool.ToolTip = "Bonk thieves to make them drop your egg!"
	tool.CanBeDropped = false
	tool.RequiresHandle = true
	tool.Grip = restGrip(scale)

	local handle = Instance.new("Part")
	handle.Name = "Handle"
	handle.Size = Vector3.new(0.7, 0.7, 4.6) * scale
	handle.Color = Color3.fromRGB(125, 85, 50)
	handle.Material = Enum.Material.Wood
	handle.CanCollide = false
	handle.Massless = true
	handle.TopSurface = Enum.SurfaceType.Smooth
	handle.BottomSurface = Enum.SurfaceType.Smooth
	handle.CFrame = CFrame.new()
	handle.Parent = tool

	local tip = Instance.new("Part")
	tip.Name = "AuraTip"
	tip.Size = Vector3.new(1, 1, 1.6) * scale
	tip.Color = Color3.fromRGB(120, 220, 255)
	tip.Material = Enum.Material.Neon
	tip.CanCollide = false
	tip.CanTouch = false
	tip.CanQuery = false
	tip.Massless = true
	tip.TopSurface = Enum.SurfaceType.Smooth
	tip.BottomSurface = Enum.SurfaceType.Smooth
	tip.CFrame = handle.CFrame * CFrame.new(0, 0, -1.9 * scale) -- the far end, away from the hand
	tip.Parent = tool

	local tipWeld = Instance.new("WeldConstraint")
	tipWeld.Part0 = handle
	tipWeld.Part1 = tip
	tipWeld.Parent = tip

	local swingSound = Instance.new("Sound")
	swingSound.Name = "SwingSound"
	swingSound.SoundId = "rbxasset://sounds/swordslash.wav" -- built into every Roblox install
	swingSound.Volume = 0.6
	swingSound.Parent = handle

	return tool
end

local function getLiving(player)
	local character = player.Character
	if not character then
		return nil, nil
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local root = character:FindFirstChild("HumanoidRootPart")
	if not humanoid or not root or humanoid.Health <= 0 then
		return nil, nil
	end
	return humanoid, root
end

local function swing(player, tool)
	local character = player.Character
	if not character or tool.Parent ~= character then
		return -- only works while equipped
	end
	local _, root = getLiving(player)
	if not root then
		return
	end

	local now = time()
	if now - (lastSwing[player] or -math.huge) < Config.BatCooldown then
		return
	end
	lastSwing[player] = now

	local handle = tool:FindFirstChild("Handle")
	local sound = handle and handle:FindFirstChild("SwingSound")
	if sound then
		sound:Play()
	end

	local scale = tool:GetAttribute("Scale") or 1
	tool.Grip = swingGrip(scale)
	task.delay(0.25, function()
		if tool.Parent then
			tool.Grip = restGrip(scale)
		end
	end)

	local look = root.CFrame.LookVector
	local reach = Config.BatRange * scale
	for _, other in Players:GetPlayers() do
		if other ~= player then
			local _, otherRoot = getLiving(other)
			if otherRoot then
				local offset = otherRoot.Position - root.Position
				local distance = offset.Magnitude
				local flat = Vector3.new(offset.X, 0, offset.Z)
				if distance <= reach then
					-- must be roughly in front of the swinger (or right on top of them)
					local inFront = flat.Magnitude < 1 or look:Dot(flat.Unit) > 0.1
					if inFront then
						local direction = flat.Magnitude >= 0.05 and flat.Unit or look
						PlotService.OnPlayerBonked(other, player)
						Remotes.Knockback(other, direction * Config.BatKnockback + Vector3.new(0, 30, 0))
					end
				end
			end
		end
	end
end

local function hookTool(player, tool)
	if hookedTools[tool] then
		return
	end
	hookedTools[tool] = true
	tool.Activated:Connect(function()
		swing(player, tool)
	end)
end

local function hasBat(player)
	local backpack = player:FindFirstChildOfClass("Backpack")
	local character = player.Character
	return (backpack ~= nil and backpack:FindFirstChild(Config.BatName) ~= nil)
		or (character ~= nil and character:FindFirstChild(Config.BatName) ~= nil)
end

function BatService.Init()
	template = buildBat(1)
	template.Parent = StarterPack -- everyone gets a copy each time they spawn
end

-- Hooks up any bat the character equips (tools move into the character when equipped).
function BatService.HookCharacter(player, character)
	character.ChildAdded:Connect(function(child)
		if child:IsA("Tool") and child.Name == Config.BatName then
			hookTool(player, child)
		end
	end)
	for _, child in character:GetChildren() do
		if child:IsA("Tool") and child.Name == Config.BatName then
			hookTool(player, child)
		end
	end
end

-- Gives a bat if the player somehow spawned without one.
function BatService.EnsureBat(player)
	if player.Parent ~= Players or not template or hasBat(player) then
		return
	end
	local backpack = player:FindFirstChildOfClass("Backpack")
	if backpack then
		template:Clone().Parent = backpack
	end
end

-- Swaps the player's bat for one built at `scale` when their size changed.
function BatService.MatchScale(player, scale)
	local backpack = player:FindFirstChildOfClass("Backpack")
	local character = player.Character
	local current = (character and character:FindFirstChild(Config.BatName))
		or (backpack and backpack:FindFirstChild(Config.BatName))
	if not current or not current:IsA("Tool") then
		return
	end
	if math.abs((current:GetAttribute("Scale") or 1) - scale) < 0.01 then
		return
	end

	local equipped = character ~= nil and current.Parent == character
	local replacement = buildBat(scale)
	current:Destroy()
	if equipped then
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		replacement.Parent = backpack or character
		if humanoid then
			humanoid:EquipTool(replacement)
		end
	elseif backpack then
		replacement.Parent = backpack
	end
end

function BatService.Forget(player)
	lastSwing[player] = nil
end

return BatService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">ConveyorService</string>
          <string name="Source"><![CDATA[--[[
	ConveyorService
	Spawns random Aura Eggs from the Aura Egg Machine, slides them down the
	belt, and lets players buy them. A bought egg goes straight onto a free
	pedestal in the buyer's base.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local EggVisuals = require(script.Parent.EggVisuals)
local Session = require(script.Parent.Session)
local Remotes = require(script.Parent.Remotes)
local PlotService = require(script.Parent.PlotService)
local EventService = require(script.Parent.EventService)

local ConveyorService = {}

local COLOR_GOOD = Color3.fromRGB(110, 255, 140)
local COLOR_BAD = Color3.fromRGB(255, 90, 90)
local COLOR_PRICE = Color3.fromRGB(255, 220, 70)
local MAX_BUY_DISTANCE = 20

local rng = Random.new()
local beltEggs = {} -- array of { Model, EggId, Mutation, Price, X, Angle, HalfHeight, Bought }
local belt = nil
local folder = nil

local function positionEgg(entry)
	local y = belt.SurfaceY + entry.HalfHeight + 0.3
	entry.Model:PivotTo(CFrame.new(entry.X, y, belt.Z) * CFrame.Angles(0, entry.Angle, 0))
end

local function removeEntry(entry)
	local index = table.find(beltEggs, entry)
	if index then
		table.remove(beltEggs, index)
	end
	if entry.Model then
		entry.Model:Destroy()
	end
end

local function tryBuy(player, entry)
	if entry.Bought or not entry.Model.Parent or PlotService.IsShuttingDown() then
		return
	end

	local session = Session.Get(player)
	if not session or not session.Loaded then
		return
	end

	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root or (root.Position - entry.Model:GetPivot().Position).Magnitude > MAX_BUY_DISTANCE then
		return
	end

	local eggName = Config.GetEggDisplayName(entry.EggId, entry.Mutation)
	local plot = PlotService.GetPlot(player)
	if not plot then
		Remotes.Notify(player, "You don't have a base yet!", COLOR_BAD)
		return
	end

	local slotIndex = PlotService.FindFreeSlot(plot)
	if not slotIndex then
		Remotes.Notify(player, "Your base is full! Sell an egg to make room.", COLOR_BAD)
		return
	end

	if not Session.TrySpend(player, entry.Price) then
		Remotes.Notify(player, "You need " .. Config.FormatCash(entry.Price) .. " to buy the " .. eggName .. "!", COLOR_BAD)
		return
	end

	entry.Bought = true
	removeEntry(entry)
	PlotService.PlaceEgg(plot, slotIndex, entry.EggId, entry.Mutation)
	Remotes.Notify(player, "You bought the " .. eggName .. "! It's on your base now.", COLOR_GOOD)
end

local function spawnEgg()
	if #beltEggs >= Config.BeltMaxEggs then
		return
	end

	-- During an AURA STORM rare eggs are more likely and some come out Storm-charged.
	local storm = EventService.IsActive()
	local eggId = Config.RollEggId(rng, nil, storm and Config.Event.RareLuck or 1)
	local mutationName = nil
	if storm and rng:NextNumber() < Config.Event.StormChance then
		mutationName = "Storm"
	end
	local price = Config.GetEggPrice(eggId, mutationName)
	local eggName = Config.GetEggDisplayName(eggId, mutationName)

	local model, def, core = EggVisuals.Create(eggId, true, mutationName)
	EggVisuals.AddInfo(model, Config.FormatCash(price), COLOR_PRICE)

	local entry = {
		Model = model,
		EggId = eggId,
		Mutation = mutationName,
		Price = price,
		X = belt.StartX,
		Angle = rng:NextNumber() * math.pi * 2,
		HalfHeight = core.Size.Y / 2,
		Bought = false,
	}

	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "BuyPrompt"
	prompt.ActionText = "Buy " .. Config.FormatCash(price)
	prompt.ObjectText = eggName
	prompt.HoldDuration = 0.25
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.MaxActivationDistance = 12
	prompt.RequiresLineOfSight = false
	prompt.Triggered:Connect(function(player)
		tryBuy(player, entry)
	end)
	prompt.Parent = core

	positionEgg(entry)
	model.Parent = folder
	table.insert(beltEggs, entry)

	local rarity = Config.GetRarity(def.Rarity)
	if rarity.Index >= Config.AnnounceRarityIndex then
		Remotes.NotifyAll("A " .. def.Rarity .. " " .. eggName .. " just came out of the machine!", rarity.Color)
	end
end

local function step(dt)
	for index = #beltEggs, 1, -1 do
		local entry = beltEggs[index]
		entry.X += Config.BeltSpeed * dt
		entry.Angle += dt * 0.8
		if entry.X >= belt.EndX then
			table.remove(beltEggs, index)
			entry.Model:Destroy()
		else
			positionEgg(entry)
		end
	end
end

function ConveyorService.Init(beltInfo)
	belt = beltInfo

	folder = Instance.new("Folder")
	folder.Name = "BeltEggs"
	folder.Parent = workspace

	RunService.Heartbeat:Connect(step)

	task.spawn(function()
		while true do
			local ok, err = pcall(spawnEgg)
			if not ok then
				warn("[StealTheAuraEgg] Belt spawn error: " .. tostring(err))
			end
			local interval = Config.BeltSpawnInterval
			if EventService.IsActive() then
				interval *= Config.Event.SpawnIntervalMultiplier
			end
			task.wait(interval)
		end
	end)
end

return ConveyorService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">DataManager</string>
          <string name="Source"><![CDATA[--[[
	DataManager
	Loads and saves player progress (cash, steals and the eggs on each
	pedestal) with DataStoreService.

	Safety features (stealing moves eggs between players, so a stale or
	out-of-order save could duplicate eggs):
	  - Session lock: a server stamps the record with its JobId when it loads a
	    player, and other servers wait for that lock to be released (or go
	    stale) before loading the same player.
	  - Saves for the same player never overlap: if a save is already running,
	    the newest snapshot is queued and written right after it.
	  - WaitForAll() lets the server wait for every save before shutting down.

	In Studio, saving only works if the place is published and
	"Enable Studio Access to API Services" is on (Game Settings > Security).
	If DataStores are unavailable the game still runs, it just won't save.
]]

local DataStoreService = game:GetService("DataStoreService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

local DataManager = {}

local SAVE_ATTEMPTS = 3
local LOAD_ATTEMPTS = 8
local FORCE_LOCK_ATTEMPT = 7 -- after this many tries (~20 s) take over a lock that was never released
local LOCK_STALE_SECONDS = Config.AutosaveInterval * 3 -- autosaves refresh the lock
local LOAD_RETRY_WAIT = 3

local store = nil
do
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(Config.DataStoreName)
	end)
	if ok then
		store = result
	else
		warn("[StealTheAuraEgg] DataStores are unavailable, progress will not be saved: " .. tostring(result))
	end
end

local writing = {} -- [userId] = true while a save worker is running
local queued = {} -- [userId] = { Data, Release } newest snapshot waiting to be written
local inFlight = 0

local function keyFor(userId)
	return "Player_" .. tostring(userId)
end

local function defaultData()
	return {
		Cash = Config.StartingCash,
		Steals = 0,
		Speed = 0,
		BaseLevel = 1,
		Eggs = {}, -- [slotIndex: number] = saved item, see Config.EncodeEgg
	}
end

local function isValidCount(value)
	-- rejects NaN, negatives and infinity
	return type(value) == "number" and value == value and value >= 0 and value < math.huge
end

local function sanitize(raw)
	local data = defaultData()
	if type(raw) ~= "table" then
		return data
	end

	if isValidCount(raw.Cash) then
		data.Cash = math.floor(raw.Cash)
	end
	if isValidCount(raw.Steals) then
		data.Steals = math.floor(raw.Steals)
	end
	if isValidCount(raw.BaseLevel) then
		data.BaseLevel = math.clamp(math.floor(raw.BaseLevel), 1, #Config.BaseUpgrades)
	end

	if isValidCount(raw.Speed) then
		data.Speed = math.min(raw.Speed, Config.MaxSpeed)
	end

	if type(raw.Eggs) == "table" then
		for key, saved in raw.Eggs do
			local index = tonumber(key)
			local eggId, mutationName, hatched, hatchLeft = Config.DecodeEgg(saved)
			if index and index == math.floor(index) and index >= 1 and index <= Config.SlotsPerPlot and eggId then
				data.Eggs[index] = Config.EncodeEgg(eggId, mutationName, hatched, hatchLeft)
			end
		end
	end

	-- Saves from before base upgrades existed: keep every pedestal that already holds an egg.
	if raw.BaseLevel == nil then
		local highest = 0
		for index in data.Eggs do
			highest = math.max(highest, index)
		end
		for level, upgrade in Config.BaseUpgrades do
			if upgrade.Slots >= highest then
				data.BaseLevel = math.max(data.BaseLevel, level)
				break
			end
		end
	end

	return data
end

local function isLockedByOtherServer(record)
	if type(record) ~= "table" or type(record.Lock) ~= "table" then
		return false
	end
	local lock = record.Lock
	if lock.JobId == game.JobId then
		return false
	end
	return type(lock.Time) == "number" and os.time() - lock.Time < LOCK_STALE_SECONDS
end

-- Exposed for the automated tests (tests/specs/data.spec.luau).
DataManager._Sanitize = sanitize

function DataManager.IsAvailable()
	return store ~= nil
end

-- Returns (data, canSave). canSave is false when loading failed, so the
-- caller must not save over what is really stored.
function DataManager.Load(player)
	if not store then
		return defaultData(), false
	end

	local userId = player.UserId
	local key = keyFor(userId)

	-- If this server is still writing this player's last session (quick rejoin), let it finish.
	for _ = 1, 60 do
		if not writing[userId] then
			break
		end
		task.wait(0.25)
	end

	for attempt = 1, LOAD_ATTEMPTS do
		local loaded = nil
		local blocked = false
		local ok, err = pcall(function()
			store:UpdateAsync(key, function(old)
				-- this callback can run more than once, so reset the results each time
				loaded = nil
				blocked = false
				if attempt < FORCE_LOCK_ATTEMPT and isLockedByOtherServer(old) then
					blocked = true
					return nil -- cancel the write, try again later
				end
				local record = type(old) == "table" and old or {}
				loaded = sanitize(record)
				record.Lock = { JobId = game.JobId, Time = os.time() }
				return record
			end)
		end)

		if player.Parent == nil then
			-- Left while loading: give the lock back so their next server can load right away.
			if ok and loaded then
				pcall(function()
					store:UpdateAsync(key, function(old)
						if type(old) == "table" and type(old.Lock) == "table" and old.Lock.JobId == game.JobId then
							old.Lock = nil
							return old
						end
						return nil
					end)
				end)
			end
			return defaultData(), false
		end
		if ok and loaded then
			return loaded, true
		end
		if not ok then
			warn(string.format("[StealTheAuraEgg] Load failed for %s (attempt %d): %s", player.Name, attempt, tostring(err)))
		elseif blocked then
			warn(string.format("[StealTheAuraEgg] %s is still locked by another server (attempt %d)", player.Name, attempt))
		end
		if attempt < LOAD_ATTEMPTS then
			task.wait(LOAD_RETRY_WAIT)
		end
	end

	return defaultData(), false
end

local function write(userId, job)
	local key = keyFor(userId)
	for attempt = 1, SAVE_ATTEMPTS do
		local refused = false
		local ok, err = pcall(function()
			store:UpdateAsync(key, function(old)
				refused = false
				if isLockedByOtherServer(old) then
					refused = true -- another server owns this player now; never overwrite it
					return nil
				end
				local record = {
					Cash = job.Data.Cash,
					Steals = job.Data.Steals,
					Speed = job.Data.Speed,
					BaseLevel = job.Data.BaseLevel,
					Eggs = job.Data.Eggs,
				}
				if not job.Release then
					record.Lock = { JobId = game.JobId, Time = os.time() }
				end
				return record
			end)
		end)
		if ok then
			if refused then
				warn("[StealTheAuraEgg] Skipped saving " .. tostring(userId) .. ": another server owns the data")
			end
			return
		end
		warn(string.format("[StealTheAuraEgg] Save failed for %s (attempt %d): %s", tostring(userId), attempt, tostring(err)))
		if attempt < SAVE_ATTEMPTS then
			task.wait(attempt)
		end
	end
end

-- data = { Cash = number, Steals = number, Speed = number, Eggs = { ["1"] = eggId, ... } }
-- Egg keys must be strings so the DataStore stores a dictionary, not a holey array.
-- release = true for the final save of a session (player leaving / server closing).
-- Does not yield: the write happens in the background, in order, per player.
function DataManager.Save(userId, data, release)
	if not store or not data then
		return
	end

	local previous = queued[userId]
	queued[userId] = {
		Data = data,
		Release = (release == true) or (previous ~= nil and previous.Release),
	}

	if writing[userId] then
		return -- the running worker will pick up the newest snapshot
	end
	writing[userId] = true
	inFlight += 1

	task.spawn(function()
		while queued[userId] do
			local job = queued[userId]
			queued[userId] = nil
			local ok, err = pcall(write, userId, job)
			if not ok then
				warn("[StealTheAuraEgg] Save error for " .. tostring(userId) .. ": " .. tostring(err))
			end
		end
		writing[userId] = nil
		inFlight -= 1
	end)
end

-- Yields until every save has finished (or maxSeconds passes).
function DataManager.WaitForAll(maxSeconds)
	local waited = 0
	while inFlight > 0 and waited < maxSeconds do
		task.wait(0.1)
		waited += 0.1
	end
end

return DataManager
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">EggVisuals</string>
          <string name="Source"><![CDATA[--[[
	EggVisuals
	Builds the 3D model for an Aura Egg: an egg-shaped core, a glowing band,
	an aura shell, sparkle particles and a light. Higher rarities are
	bigger and glow more. Secret eggs get a rainbow aura (animated by the client).

	Also shared with PetVisuals: the aura effects (AddEffects) and the floating
	name tag (AddInfo).

	Every item model gets these attributes: EggId, Mutation (optional),
	Hatched (true for animals), BottomOffset (studs from the core's centre down
	to the model's bottom) and TopOffset (from the centre up to the top).
]]

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

local EggVisuals = {}

local BASE_SIZE = Vector3.new(2.6, 3.4, 2.6)
local RAINBOW = ColorSequence.new({
	ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 60, 60)),
	ColorSequenceKeypoint.new(0.2, Color3.fromRGB(255, 200, 40)),
	ColorSequenceKeypoint.new(0.4, Color3.fromRGB(80, 255, 80)),
	ColorSequenceKeypoint.new(0.6, Color3.fromRGB(60, 200, 255)),
	ColorSequenceKeypoint.new(0.8, Color3.fromRGB(120, 80, 255)),
	ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 60, 200)),
})

function EggVisuals.MakeEllipsoid(name, size, color, material, transparency, anchored)
	local part = Instance.new("Part")
	part.Name = name
	part.Size = size
	part.Color = color
	part.Material = material
	part.Transparency = transparency
	part.Anchored = anchored
	part.CanCollide = false
	part.CanTouch = false
	part.CastShadow = false
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth

	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere -- a Sphere SpecialMesh stretches to the part size
	mesh.Parent = part
	return part
end

function EggVisuals.Weld(part0, part1)
	local constraint = Instance.new("WeldConstraint")
	constraint.Part0 = part0
	constraint.Part1 = part1
	constraint.Parent = part1
end

-- Rarity scale used for eggs and animals: Common 1.0 ... Secret 1.6
function EggVisuals.RarityScale(def)
	return 1 + 0.1 * (Config.GetRarity(def.Rarity).Index - 1)
end

-- Aura shell, sparkles, light and mutation effects around `core`.
-- shellSize = size of the glowing aura ellipsoid (centred on the core).
function EggVisuals.AddEffects(model, core, def, mutationName, shellSize, anchored)
	local rarity = Config.GetRarity(def.Rarity)
	local scale = EggVisuals.RarityScale(def)
	local mutation = Config.GetMutation(mutationName)
	local isSecret = def.Rarity == "Secret"

	local strongAura = rarity.Index >= 4 -- Epic and above get the shimmering force-field aura
	local shell = EggVisuals.MakeEllipsoid(
		"Aura",
		shellSize,
		def.AuraColor,
		strongAura and Enum.Material.ForceField or Enum.Material.Neon,
		strongAura and 0 or 0.82,
		anchored
	)
	shell.CanQuery = false
	shell.CFrame = CFrame.new(core.Position)
	shell.Parent = model
	EggVisuals.Weld(core, shell)
	if isSecret then
		CollectionService:AddTag(shell, "RainbowAura")
	end

	local attachment = Instance.new("Attachment")
	attachment.Name = "AuraAttachment"
	attachment.Parent = core

	local emitter = Instance.new("ParticleEmitter")
	emitter.Name = "AuraSparkles"
	emitter.Color = isSecret and RAINBOW or ColorSequence.new(def.AuraColor)
	emitter.LightEmission = 1
	emitter.Rate = 4 + rarity.Index * 4
	emitter.Lifetime = NumberRange.new(1, 1.8)
	emitter.Speed = NumberRange.new(1, 3)
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.Rotation = NumberRange.new(0, 360)
	emitter.RotSpeed = NumberRange.new(-90, 90)
	emitter.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.35 * scale),
		NumberSequenceKeypoint.new(1, 0),
	})
	emitter.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.1),
		NumberSequenceKeypoint.new(1, 1),
	})
	emitter.Parent = attachment

	local light = Instance.new("PointLight")
	light.Color = def.AuraColor
	light.Brightness = 1 + rarity.Index * 0.3
	light.Range = 6 + rarity.Index
	light.Shadows = false
	light.Parent = core

	if mutation then
		-- Storm-charged: an electric outer shell, crackling sparks and a blue glow
		local stormShell = EggVisuals.MakeEllipsoid(
			"MutationAura",
			shellSize * 1.2,
			mutation.Color,
			Enum.Material.ForceField,
			0,
			anchored
		)
		stormShell.CanQuery = false
		stormShell.CFrame = CFrame.new(core.Position)
		stormShell.Parent = model
		EggVisuals.Weld(core, stormShell)

		local sparks = Instance.new("ParticleEmitter")
		sparks.Name = "MutationSparks"
		sparks.Color = ColorSequence.new(mutation.Color)
		sparks.LightEmission = 1
		sparks.Rate = 25
		sparks.Lifetime = NumberRange.new(0.15, 0.35)
		sparks.Speed = NumberRange.new(6, 10)
		sparks.SpreadAngle = Vector2.new(180, 180)
		sparks.Size = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.25 * scale),
			NumberSequenceKeypoint.new(1, 0),
		})
		sparks.Parent = attachment

		local stormLight = Instance.new("PointLight")
		stormLight.Name = "MutationLight"
		stormLight.Color = mutation.Color
		stormLight.Brightness = 2.5
		stormLight.Range = 12
		stormLight.Shadows = false
		stormLight.Parent = core
	end
end

-- Sets the attributes every item model carries.
function EggVisuals.Tag(model, def, mutationName, hatched, bottomOffset, topOffset)
	local mutation = Config.GetMutation(mutationName)
	model.Name = Config.GetEggDisplayName(def.Id, mutationName, hatched)
	model:SetAttribute("EggId", def.Id)
	model:SetAttribute("Hatched", hatched == true)
	if mutation then
		model:SetAttribute("Mutation", mutation.Name)
	end
	model:SetAttribute("BottomOffset", bottomOffset)
	model:SetAttribute("TopOffset", topOffset)
end

-- Returns model, eggDefinition, corePart. The model's PrimaryPart is the core.
-- mutationName (optional), e.g. "Storm", adds the mutation's look.
function EggVisuals.Create(eggId, anchored, mutationName)
	local def = Config.GetEgg(eggId)
	assert(def, "Unknown egg id: " .. tostring(eggId))
	local scale = EggVisuals.RarityScale(def)

	local model = Instance.new("Model")

	local core =
		EggVisuals.MakeEllipsoid("Core", BASE_SIZE * scale, def.EggColor, Enum.Material.SmoothPlastic, 0, anchored)
	core.CastShadow = true
	core.CFrame = CFrame.new()
	core.Parent = model

	local band = EggVisuals.MakeEllipsoid(
		"Band",
		Vector3.new(core.Size.X * 1.04, 0.45 * scale, core.Size.Z * 1.04),
		def.AuraColor,
		Enum.Material.Neon,
		0,
		anchored
	)
	band.CFrame = CFrame.new(0, -0.15 * scale, 0)
	band.Parent = model
	EggVisuals.Weld(core, band)
	if def.Rarity == "Secret" then
		CollectionService:AddTag(band, "RainbowAura")
	end

	EggVisuals.AddEffects(model, core, def, mutationName, core.Size * 1.35, anchored)
	EggVisuals.Tag(model, def, mutationName, false, core.Size.Y / 2, core.Size.Y / 2)

	model.PrimaryPart = core
	return model, def, core
end

local function addLine(gui, text, color, index, count, rainbow)
	local label = Instance.new("TextLabel")
	label.Name = "Line" .. index
	label.BackgroundTransparency = 1
	label.Size = UDim2.new(1, 0, 1 / count, 0)
	label.Position = UDim2.new(0, 0, (index - 1) / count, 0)
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.Text = text
	label.TextColor3 = color
	label.TextStrokeTransparency = 0
	label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
	label.Parent = gui
	if rainbow then
		CollectionService:AddTag(label, "RainbowText")
	end
	return label
end

-- Adds the floating name / rarity / income text above an egg or animal.
-- extraText (optional) adds one more line, e.g. the price on the belt or the hatch timer.
-- Returns the BillboardGui and the extra line's TextLabel (nil without extraText).
function EggVisuals.AddInfo(model, extraText, extraColor)
	local core = model.PrimaryPart
	local def = Config.GetEgg(model:GetAttribute("EggId"))
	local rarity = Config.GetRarity(def.Rarity)
	local mutationName = model:GetAttribute("Mutation")
	local mutation = Config.GetMutation(mutationName)
	local hatched = model:GetAttribute("Hatched") == true
	local topOffset = model:GetAttribute("TopOffset") or core.Size.Y / 2

	local lines = {
		{ hatched and def.PetName or def.Name, Color3.fromRGB(255, 255, 255), false },
		{ def.Rarity .. (hatched and " Animal" or ""), rarity.Color, def.Rarity == "Secret" },
	}
	if mutation then
		table.insert(lines, { string.upper(mutation.Name) .. " x" .. mutation.IncomeMultiplier, mutation.Color, false })
	end
	table.insert(lines, {
		Config.FormatCash(Config.GetEggIncome(def.Id, mutationName, hatched)) .. "/s",
		Color3.fromRGB(110, 255, 140),
		false,
	})
	if extraText then
		table.insert(lines, { extraText, extraColor or Color3.fromRGB(255, 220, 70), false })
	end

	local gui = Instance.new("BillboardGui")
	gui.Name = "EggInfo"
	gui.Adornee = core
	gui.Size = UDim2.new(7, 0, 0.8 * #lines, 0) -- scale = studs for BillboardGuis
	gui.StudsOffset = Vector3.new(0, topOffset + 0.6 + 0.4 * #lines, 0)
	gui.AlwaysOnTop = false
	gui.LightInfluence = 0
	gui.MaxDistance = 70

	local extraLabel = nil
	for index, line in lines do
		local label = addLine(gui, line[1], line[2], index, #lines, line[3])
		if extraText and index == #lines then
			extraLabel = label
		end
	end

	gui.Parent = core
	return gui, extraLabel
end

return EggVisuals
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">EventService</string>
          <string name="Source"><![CDATA[--[[
	EventService - the AURA STORM event

	Every Config.Event.Interval seconds (first one after Config.Event.FirstDelay)
	a purple lightning storm rolls in for Config.Event.Duration seconds:
	  - the sky goes dark purple with storm clouds (lightning flashes on clients)
	  - the Aura Egg Machine sends eggs out twice as fast
	  - Rare and better eggs are 3x more likely
	  - 30% of eggs come out Storm-charged (3x income, saved with the egg)

	The schedule is shared with clients through Workspace attributes:
	  EventName, EventActive, EventEndsAt, NextEventAt (server time, see
	  workspace:GetServerTimeNow()).

	In Studio, the "START STORM" button on screen starts one right away.
]]

local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Remotes = require(script.Parent.Remotes)

local EventService = {}

local STORM_COLOR = Color3.fromRGB(150, 200, 255)

local active = false
local endsAt = 0
local nextAt = 0
local warned = false
local savedLighting = nil
local stormObjects = {}

local function now()
	return workspace:GetServerTimeNow()
end

local function publish()
	workspace:SetAttribute("EventName", Config.Event.Name)
	workspace:SetAttribute("EventActive", active)
	workspace:SetAttribute("EventEndsAt", endsAt)
	workspace:SetAttribute("NextEventAt", nextAt)
end

local function applyStormLook()
	savedLighting = {
		ClockTime = Lighting.ClockTime,
		Brightness = Lighting.Brightness,
		Ambient = Lighting.Ambient,
		OutdoorAmbient = Lighting.OutdoorAmbient,
	}
	Lighting.ClockTime = 19.2
	Lighting.Brightness = 1.2
	Lighting.Ambient = Color3.fromRGB(70, 50, 110)
	Lighting.OutdoorAmbient = Color3.fromRGB(110, 80, 170)

	local tint = Instance.new("ColorCorrectionEffect")
	tint.Name = "AuraStormTint"
	tint.TintColor = Color3.fromRGB(205, 185, 255)
	tint.Saturation = 0.15
	tint.Contrast = 0.1
	tint.Parent = Lighting
	table.insert(stormObjects, tint)

	local clouds = Instance.new("Clouds")
	clouds.Name = "AuraStormClouds"
	clouds.Cover = 0.85
	clouds.Density = 0.7
	clouds.Color = Color3.fromRGB(90, 60, 140)
	clouds.Parent = workspace.Terrain
	table.insert(stormObjects, clouds)
end

local function removeStormLook()
	for _, object in stormObjects do
		object:Destroy()
	end
	table.clear(stormObjects)
	if savedLighting then
		for property, value in savedLighting do
			Lighting[property] = value
		end
		savedLighting = nil
	end
end

function EventService.IsActive()
	return active
end

function EventService.Start()
	if active then
		return
	end
	local t = now()
	active = true
	warned = false
	endsAt = t + Config.Event.Duration
	nextAt = t + Config.Event.Interval
	applyStormLook()
	publish()
	Remotes.NotifyAll(
		"The " .. Config.Event.Name .. " has begun! Rare eggs x" .. Config.Event.RareLuck .. " and Storm eggs (x3 cash)!",
		STORM_COLOR
	)
end

function EventService.Stop()
	if not active then
		return
	end
	active = false
	endsAt = 0
	removeStormLook()
	publish()
	Remotes.NotifyAll("The " .. Config.Event.Name .. " is over. Storm eggs keep their power!", STORM_COLOR)
end

local function step()
	local t = now()
	if active then
		if t >= endsAt then
			EventService.Stop()
		end
	else
		if not warned and nextAt - t <= Config.Event.WarningTime and nextAt - t > 0 then
			warned = true
			Remotes.NotifyAll(
				"An " .. Config.Event.Name .. " is coming in " .. math.ceil(nextAt - t) .. " seconds!",
				STORM_COLOR
			)
		end
		if t >= nextAt then
			EventService.Start()
		end
	end
end

function EventService.Init()
	nextAt = now() + Config.Event.FirstDelay
	publish()

	-- Studio-only test button. Live servers ignore it.
	Remotes.StartEventEvent.OnServerEvent:Connect(function()
		if RunService:IsStudio() then
			EventService.Start()
		end
	end)

	task.spawn(function()
		while true do
			task.wait(1)
			local ok, err = pcall(step)
			if not ok then
				warn("[StealTheAuraEgg] Event error: " .. tostring(err))
			end
		end
	end)
end

return EventService
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="13">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--[[
	STEAL THE AURA EGG - server entry point

	Builds the map, starts every service, and handles players joining,
	spawning, leaving and the server shutting down.
]]

local Players = game:GetService("Players")
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Server = script.Parent
local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Remotes = require(Server.Remotes) -- creates the RemoteEvents first
local MapBuilder = require(Server.MapBuilder)
local Session = require(Server.Session)
local DataManager = require(Server.DataManager)
local PlotService = require(Server.PlotService)
local ConveyorService = require(Server.ConveyorService)
local BatService = require(Server.BatService)
local TreadmillService = require(Server.TreadmillService)
local EventService = require(Server.EventService)
local SizeService = require(Server.SizeService)
local MonetizationService = require(Server.MonetizationService)

------------------------------------------------------------------------------
-- World setup
------------------------------------------------------------------------------

Lighting.ClockTime = 14.5
Lighting.Brightness = 2
Lighting.OutdoorAmbient = Color3.fromRGB(140, 130, 160)
if not Lighting:FindFirstChildOfClass("BloomEffect") then
	local bloom = Instance.new("BloomEffect")
	bloom.Intensity = 0.6
	bloom.Size = 24
	bloom.Threshold = 1.6
	bloom.Parent = Lighting
end

-- Build everything before any character can fall into the void.
local world = MapBuilder.Build()
PlotService.Init(world.Plots)
EventService.Init()
ConveyorService.Init(world.Belt)
BatService.Init()
TreadmillService.Init(world.Treadmills)
SizeService.Init()
MonetizationService.Init()

------------------------------------------------------------------------------
-- Players
------------------------------------------------------------------------------

local function onCharacterAdded(player, character)
	local humanoid = character:WaitForChild("Humanoid", 10)
	local root = character:WaitForChild("HumanoidRootPart", 10)
	if not humanoid or not root or character.Parent == nil then
		return
	end

	humanoid.WalkSpeed = Session.GetWalkSpeed(player)
	humanoid.Died:Connect(function()
		PlotService.CancelCarry(player, "You got knocked out and dropped the egg!")
	end)

	PlotService.SetupCharacter(player, character)
	SizeService.Refresh(player)
	BatService.HookCharacter(player, character)
	task.delay(1, BatService.EnsureBat, player)
end

-- When a base frees up, give it to a loaded player who joined while every base was taken.
local function giveFreeBasesToWaitingPlayers()
	for _, player in Players:GetPlayers() do
		local session = Session.Get(player)
		if session and session.Loaded and not PlotService.GetPlot(player) then
			local plot = PlotService.AssignPlot(player)
			if not plot then
				return -- no free bases left
			end
			PlotService.LoadEggs(player, session.SavedEggs or {})
			session.SavedEggs = nil
			if player.Character then
				PlotService.SetupCharacter(player, player.Character)
			end
			Remotes.Notify(player, "A base opened up. It's yours now!", Color3.fromRGB(110, 255, 140))
		end
	end
end

local function onPlayerAdded(player)
	if Session.Get(player) then
		return -- already handled
	end
	local session = Session.Create(player)
	task.spawn(MonetizationService.LoadPasses, player)

	local plot = PlotService.AssignPlot(player)

	player.CharacterAdded:Connect(function(character)
		onCharacterAdded(player, character)
	end)
	player.CharacterRemoving:Connect(function()
		PlotService.CancelCarry(player, nil)
	end)
	if player.Character then
		task.spawn(onCharacterAdded, player, player.Character)
	end

	local data, canSave = DataManager.Load(player)
	if player.Parent ~= Players then
		return -- left while loading
	end

	session.CanSave = canSave
	Session.SetCash(player, data.Cash)
	Session.SetSteals(player, data.Steals)
	Session.SetSpeed(player, data.Speed)
	session.BaseLevel = data.BaseLevel -- before LoadEggs, which refreshes the base
	PlotService.RefreshWalkSpeed(player)
	if PlotService.GetPlot(player) then
		PlotService.LoadEggs(player, data.Eggs)
	else
		session.SavedEggs = data.Eggs -- kept safe until a base frees up
	end
	session.Loaded = true

	Remotes.Notify(player, "Welcome to " .. Config.GameName .. "!", Color3.fromRGB(200, 140, 255))
	if plot then
		Remotes.Notify(player, "Your base has your name over the entrance.", Color3.fromRGB(255, 220, 90))
	else
		Remotes.Notify(player, "All bases are taken! You'll get one as soon as someone leaves.", Color3.fromRGB(255, 90, 90))
		giveFreeBasesToWaitingPlayers()
	end
	if not canSave then
		Remotes.Notify(player, "Saving is off (DataStores unavailable). Progress resets when you leave.", Color3.fromRGB(255, 150, 40))
	end
end

local function onPlayerRemoving(player)
	-- Put every egg that is mid-steal back first, so nothing is lost or duplicated.
	PlotService.PrepareForLeave(player)

	local session = Session.Get(player)
	local saveData = nil
	if session and session.Loaded and session.CanSave and not session.FinalSaved then
		saveData = PlotService.BuildSaveData(player)
	end

	PlotService.ReleasePlot(player)
	Session.Remove(player)
	BatService.Forget(player)
	PlotService.Forget(player)

	if saveData then
		DataManager.Save(player.UserId, saveData, true) -- final save, releases the session lock
	end

	if not PlotService.IsShuttingDown() then
		giveFreeBasesToWaitingPlayers()
	end
end

Players.PlayerAdded:Connect(onPlayerAdded)
Players.PlayerRemoving:Connect(onPlayerRemoving)
for _, player in Players:GetPlayers() do
	task.spawn(onPlayerAdded, player)
end

------------------------------------------------------------------------------
-- Saving
------------------------------------------------------------------------------

-- DataManager.Save never yields and never runs two saves for the same player at once.
local function saveEveryone(isFinal)
	for _, player in Players:GetPlayers() do
		local session = Session.Get(player)
		if session and session.Loaded and session.CanSave and not session.FinalSaved then
			local data = PlotService.BuildSaveData(player)
			if data then
				if isFinal then
					session.FinalSaved = true -- PlayerRemoving must not save an older/newer copy after this
				end
				DataManager.Save(player.UserId, data, isFinal)
			end
		end
	end
end

task.spawn(function()
	while true do
		task.wait(Config.AutosaveInterval)
		if PlotService.IsShuttingDown() then
			break
		end
		saveEveryone(false)
	end
end)

game:BindToClose(function()
	-- Freeze anything that moves eggs between players, then take one final snapshot.
	PlotService.BeginShutdown()
	saveEveryone(true)
	-- Wait for every save, including ones started by players who just left.
	DataManager.WaitForAll(25)
end)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="14">
        <Properties>
          <string name="Name">MapBuilder</string>
          <string name="Source"><![CDATA[--[[
	MapBuilder
	The map itself is saved in the place file (Workspace.Map and
	Workspace.Plots, generated by tools/generate_map.py), so you can see and
	edit it in Studio. This module finds the parts the game needs, adds the
	floating text labels, and hands everything to the other services.

	If you edit the map in Studio, keep these names:
	  Workspace.Map.ConveyorBelt, Workspace.Map.AuraEggMachine, Workspace.Map.TitleAnchor
	  Workspace.Plots.Plot1 .. Plot8, each containing:
	    Origin, LockBarrier, SignAnchor, LockPad, UpgradeTerminal, Eggs,
	    Pedestal1 .. Pedestal10, PedestalRim1 .. PedestalRim10, CashPad1 .. CashPad10
	  Treadmill models (attribute Tier = 1..4) with a part named Belt
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

local MapBuilder = {}

local PLOT_HALF = 28

local function need(parent, name)
	local child = parent:FindFirstChild(name)
	if not child then
		error(
			string.format("[StealTheAuraEgg] Map is missing '%s' inside %s. Did it get renamed or deleted?", name, parent:GetFullName()),
			2
		)
	end
	return child
end

-- Floating text attached to a part. size is in studs.
local function newBillboard(adornee, sizeX, sizeY, offset, text, color, maxDistance)
	local gui = Instance.new("BillboardGui")
	gui.Name = "Label"
	gui.Adornee = adornee
	gui.Size = UDim2.new(sizeX, 0, sizeY, 0)
	gui.StudsOffset = offset
	gui.AlwaysOnTop = false
	gui.LightInfluence = 0
	gui.MaxDistance = maxDistance or 150

	local label = Instance.new("TextLabel")
	label.Name = "Text"
	label.BackgroundTransparency = 1
	label.Size = UDim2.new(1, 0, 1, 0)
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.Text = text
	label.TextColor3 = color
	label.TextStrokeTransparency = 0
	label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
	label.Parent = gui

	gui.Parent = adornee
	return label
end

MapBuilder.NewBillboard = newBillboard

local function loadPlot(index, plotsFolder)
	local model = need(plotsFolder, "Plot" .. index)
	local origin = need(model, "Origin")
	local plotCFrame = origin.CFrame

	local slots = {}
	for slotIndex = 1, Config.SlotsPerPlot do
		local pedestal = need(model, "Pedestal" .. slotIndex)
		local pad = need(model, "CashPad" .. slotIndex)
		local rim = need(model, "PedestalRim" .. slotIndex)
		local pedestalLocal = plotCFrame:PointToObjectSpace(pedestal.Position)
		slots[slotIndex] = {
			Pedestal = pedestal,
			-- top centre of the pedestal, in the plot's orientation
			EggBaseCFrame = plotCFrame * CFrame.new(pedestalLocal.X, pedestalLocal.Y + pedestal.Size.Y / 2, pedestalLocal.Z),
			PadLocal = plotCFrame:PointToObjectSpace(pad.Position),
			PadLabel = newBillboard(pad, 5, 1.4, Vector3.new(0, 2.2, 0), "", Color3.fromRGB(120, 255, 140), 60),
			Pad = pad,
			PadColor = pad.Color,
			Rim = rim,
			RimColor = rim.Color,
		}
	end

	local lockPad = need(model, "LockPad")
	local upgradeTerminal = need(model, "UpgradeTerminal")
	local eggsFolder = model:FindFirstChild("Eggs")
	if not eggsFolder then
		eggsFolder = Instance.new("Folder")
		eggsFolder.Name = "Eggs"
		eggsFolder.Parent = model
	end

	model:SetAttribute("PlotIndex", index)
	model:SetAttribute("OwnerUserId", 0)
	model:SetAttribute("OwnerName", "")

	return {
		Index = index,
		Model = model,
		CFrame = plotCFrame,
		HalfSize = PLOT_HALF,
		Barrier = need(model, "LockBarrier"),
		SignLabel = newBillboard(need(model, "SignAnchor"), 22, 3.5, Vector3.new(), "Empty Base", Color3.fromRGB(255, 255, 255), 250),
		Slots = slots,
		LockPadLocal = plotCFrame:PointToObjectSpace(lockPad.Position),
		LockLabel = newBillboard(lockPad, 8, 1.6, Vector3.new(0, 2.5, 0), "", Color3.fromRGB(255, 255, 255), 80),
		EggsFolder = eggsFolder,
		UpgradeTerminal = upgradeTerminal,
		UpgradeLabel = newBillboard(upgradeTerminal, 12, 2.6, Vector3.new(0, 4, 0), "", Color3.fromRGB(255, 220, 90), 60),
		UpgradePrompt = nil, -- created by PlotService
		SpawnCFrame = plotCFrame * CFrame.new(0, 4, 6), -- facing the entrance
		EjectCFrame = plotCFrame * CFrame.new(0, 4, -38), -- just outside the entrance, on the walkway
	}
end

function MapBuilder.Build()
	local map = need(workspace, "Map")
	local plotsFolder = need(workspace, "Plots")

	local plots = {}
	for index = 1, Config.MaxPlots do
		plots[index] = loadPlot(index, plotsFolder)
	end

	local belt = need(map, "ConveyorBelt")
	newBillboard(need(map, "AuraEggMachine"), 26, 5, Vector3.new(0, 16, 0), "AURA EGG MACHINE", Color3.fromRGB(230, 180, 255), 400)
	newBillboard(need(map, "TitleAnchor"), 80, 12, Vector3.new(), string.upper(Config.GameName), Color3.fromRGB(200, 140, 255), 800)

	local treadmills = {}
	for _, descendant in map:GetDescendants() do
		if descendant:IsA("Model") and descendant.Name == "Treadmill" and descendant:GetAttribute("Tier") then
			table.insert(treadmills, descendant)
		elseif descendant:IsA("BasePart") and descendant.Name == "GymSignAnchor" then
			newBillboard(descendant, 34, 6, Vector3.new(), "TREADMILL GYM", Color3.fromRGB(120, 220, 255), 400)
		end
	end

	local halfLength = belt.Size.X / 2
	return {
		Plots = plots,
		Treadmills = treadmills,
		Belt = {
			StartX = belt.Position.X - halfLength + 3,
			EndX = belt.Position.X + halfLength - 3,
			Z = belt.Position.Z,
			SurfaceY = belt.Position.Y + belt.Size.Y / 2,
		},
	}
end

return MapBuilder
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">MonetizationService</string>
          <string name="Source"><![CDATA[--[[
	MonetizationService
	Robux purchases:
	  - Game passes (bought once, kept forever): 2x Cash, Speedy Thief, Mega Lock.
	    Ownership is stored as player attributes "Pass_<Key>" = true, which
	    PlotService reads. Only the server sets them.
	  - Developer products (can be bought again): cash packs and a Lucky Aura Egg.
	    Granted in ProcessReceipt using Roblox's recommended pattern: every
	    PurchaseId is recorded in a DataStore so a purchase is never granted twice,
	    and returning NotProcessedYet makes Roblox retry it later, so it's never lost.

	Set the IDs in ReplicatedStorage.Shared.Config (GamePasses / Products).
]]

local DataStoreService = game:GetService("DataStoreService")
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Session = require(script.Parent.Session)
local Remotes = require(script.Parent.Remotes)
local PlotService = require(script.Parent.PlotService)
local DataManager = require(script.Parent.DataManager)

local MonetizationService = {}

local COLOR_GOOD = Color3.fromRGB(110, 255, 140)

local rng = Random.new()
local passById = {}
local productById = {}

for _, pass in Config.GamePasses do
	if pass.Id ~= 0 then
		passById[pass.Id] = pass
	end
end
for _, product in Config.Products do
	if product.Id ~= 0 then
		productById[product.Id] = product
	end
end

local purchaseStore = nil
do
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(Config.DataStoreName .. "_Purchases")
	end)
	if ok then
		purchaseStore = result
	end
end

local function grantPass(player, pass, announce)
	if player:GetAttribute("Pass_" .. pass.Key) == true then
		return
	end
	player:SetAttribute("Pass_" .. pass.Key, true)
	if announce then
		Remotes.Notify(player, "You got " .. pass.Name .. "! " .. pass.Description, COLOR_GOOD)
	end
end

-- Checks which game passes the player owns (yields).
function MonetizationService.LoadPasses(player)
	for _, pass in Config.GamePasses do
		if pass.Id ~= 0 then
			local ok, owns = pcall(function()
				return MarketplaceService:UserOwnsGamePassAsync(player.UserId, pass.Id)
			end)
			if player.Parent ~= Players then
				return
			end
			if ok and owns then
				grantPass(player, pass, false)
			elseif not ok then
				warn("[StealTheAuraEgg] Could not check game pass " .. pass.Key .. ": " .. tostring(owns))
			end
		end
	end
end

-- Gives the product to the player. Must not yield. Returns true on success.
local function grantProduct(player, product)
	if product.Cash then
		Session.AddCash(player, product.Cash)
		Remotes.Notify(player, "You got " .. Config.FormatCash(product.Cash) .. "!", COLOR_GOOD)
		return true
	end

	if product.LuckyEgg then
		local eggId = Config.RollEggId(rng, Config.LuckyEggMinRarity)
		local def = Config.GetEgg(eggId)
		local rarity = Config.GetRarity(def.Rarity)
		local plot = PlotService.GetPlot(player)
		local slotIndex = plot and PlotService.FindFreeSlot(plot)
		if plot and slotIndex then
			PlotService.PlaceEgg(plot, slotIndex, eggId)
			Remotes.Notify(player, "Lucky! You got a " .. def.Rarity .. " " .. def.Name .. "!", rarity.Color)
		else
			-- No room on the base: pay out the egg's full price instead so nothing is lost.
			Session.AddCash(player, def.Price)
			Remotes.Notify(
				player,
				"Your base was full, so your " .. def.Name .. " became " .. Config.FormatCash(def.Price) .. "!",
				rarity.Color
			)
		end
		Remotes.NotifyAll(player.DisplayName .. " got a " .. def.Rarity .. " " .. def.Name .. " from a Lucky Egg!", rarity.Color)
		return true
	end

	return false
end

local function processReceipt(receiptInfo)
	local product = productById[receiptInfo.ProductId]
	if not product then
		warn("[StealTheAuraEgg] Unknown developer product: " .. tostring(receiptInfo.ProductId))
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	local player = Players:GetPlayerByUserId(receiptInfo.PlayerId)
	local session = player and Session.Get(player)
	if not player or not session or not session.Loaded or PlotService.IsShuttingDown() then
		return Enum.ProductPurchaseDecision.NotProcessedYet -- Roblox retries later
	end

	-- No DataStores (e.g. an unpublished Studio test): just grant it.
	if not purchaseStore or not DataManager.IsAvailable() then
		if grantProduct(player, product) then
			return Enum.ProductPurchaseDecision.PurchaseGranted
		end
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	-- Their save didn't load, so anything granted now would be lost. Wait for a later retry.
	if not session.CanSave then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	local ok, recorded = pcall(function()
		return purchaseStore:UpdateAsync(receiptInfo.PurchaseId, function(alreadyGranted)
			if alreadyGranted then
				return true -- granted before (Roblox called us again); don't give it twice
			end
			if player.Parent ~= Players then
				return nil -- left: cancel, Roblox retries later
			end
			if not grantProduct(player, product) then
				error("Failed to grant product " .. product.Key)
			end
			return true
		end)
	end)

	if not ok then
		warn("[StealTheAuraEgg] ProcessReceipt failed: " .. tostring(recorded))
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	if recorded == nil then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	-- Save soon so the purchase is stored with the player's progress.
	if player.Parent == Players and session.CanSave and not session.FinalSaved then
		DataManager.Save(player.UserId, PlotService.BuildSaveData(player), false)
	end
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

function MonetizationService.Init()
	MarketplaceService.ProcessReceipt = processReceipt

	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, wasPurchased)
		local pass = passById[passId]
		if wasPurchased and pass and player.Parent == Players then
			grantPass(player, pass, true)
		end
	end)
end

return MonetizationService
