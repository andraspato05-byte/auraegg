------------------------------------------------------------------------------
-- Bat knockback
------------------------------------------------------------------------------

knockbackEvent.OnClientEvent:Connect(function(velocity)
	if typeof(velocity) ~= "Vector3" then
		return
	end
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not humanoid or not root or humanoid.Health <= 0 then
		return
	end

	humanoid.PlatformStand = true
	root.AssemblyLinearVelocity = velocity
	task.delay(0.6, function()
		if humanoid.Parent then
			humanoid.PlatformStand = false
		end
	end)
end)

------------------------------------------------------------------------------
-- Treadmills: push the runner back (also set locally so it always works)
-- and scroll the stripes so the belts look like they're moving
------------------------------------------------------------------------------

local pushByTier = {}
for _, tier in Config.Treadmills do
	pushByTier[tier.Tier] = tier.PushSpeed
end

local movingStripes = {} -- { Part, Belt, X, Y, StartZ, Push }
local setupTreadmills = {}

local function setupTreadmill(treadmill)
	if setupTreadmills[treadmill] then
		return
	end
	local belt = treadmill:FindFirstChild("Belt")
	local push = pushByTier[treadmill:GetAttribute("Tier")]
	if not belt or not belt:IsA("BasePart") or not push then
		return
	end
	setupTreadmills[treadmill] = true
	belt.AssemblyLinearVelocity = -belt.CFrame.LookVector * push

	for _, child in treadmill:GetChildren() do
		if child:IsA("BasePart") and child.Name == "Stripe" then
			local localPos = belt.CFrame:PointToObjectSpace(child.Position)
			table.insert(movingStripes, {
				Part = child,
				Belt = belt,
				X = localPos.X,
				Y = localPos.Y,
				StartZ = localPos.Z,
				Push = push,
			})
		end
	end
end

local function considerTreadmill(instance)
	if instance:IsA("Model") and instance.Name == "Treadmill" then
		-- children can arrive a moment after the model
		task.defer(setupTreadmill, instance)
	end
end

workspace.DescendantAdded:Connect(considerTreadmill)
for _, descendant in workspace:GetDescendants() do
	considerTreadmill(descendant)
end

RunService.RenderStepped:Connect(function()
	local t = os.clock()
	for _, stripe in movingStripes do
		local length = stripe.Belt.Size.Z
		local half = length / 2
		-- the belt surface moves towards local +Z (the back of the treadmill)
		local z = ((stripe.StartZ + half + t * stripe.Push) % length) - half
		stripe.Part.CFrame = stripe.Belt.CFrame * CFrame.new(stripe.X, stripe.Y, z)
	end
end)

------------------------------------------------------------------------------
-- SIZE MOG: show the button when a smaller player is close enough
------------------------------------------------------------------------------

local mogTarget = nil
local mogReadyAt = 0

local function findMogTarget()
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root then
		return nil
	end
	local myScale = player:GetAttribute("Size") or 1
	local range = Config.MogRange * myScale
	local best, bestDistance = nil, math.huge
	for _, other in Players:GetPlayers() do
		if other ~= player then
			local otherCharacter = other.Character
			local otherRoot = otherCharacter and otherCharacter:FindFirstChild("HumanoidRootPart")
			local otherHumanoid = otherCharacter and otherCharacter:FindFirstChildOfClass("Humanoid")
			local theirScale = other:GetAttribute("Size") or 1
			if otherRoot and otherHumanoid and otherHumanoid.Health > 0 and myScale - theirScale >= Config.MogMinLead then
				local distance = (otherRoot.Position - root.Position).Magnitude
				if distance <= range and distance < bestDistance then
					best, bestDistance = other, distance
				end
			end
		end
	end
	return best
end

-- The server sets "MogReadyAt" (server clock) after a successful MOG.
local function mogCooldownLeft()
	local readyAt = player:GetAttribute("MogReadyAt")
	local serverLeft = type(readyAt) == "number" and readyAt - workspace:GetServerTimeNow() or 0
	return math.max(serverLeft, mogReadyAt - os.clock())
end

local function tryMog()
	if mogTarget and mogTarget.Parent == Players and mogCooldownLeft() <= 0 then
		mogRemote:FireServer(mogTarget)
		mogReadyAt = os.clock() + 0.5 -- short local debounce; the server decides the real cooldown
	end
end

task.spawn(function()
	while true do
		mogTarget = findMogTarget()
		if mogTarget then
			local remaining = mogCooldownLeft()
			mogButton.Visible = true
			if remaining > 0 then
				mogButton.Text = "MOG in " .. math.ceil(remaining) .. "s"
				mogButton.BackgroundColor3 = Color3.fromRGB(120, 90, 110)
			else
				mogButton.Text = "MOG " .. mogTarget.DisplayName .. "! (G)"
				mogButton.BackgroundColor3 = Color3.fromRGB(255, 70, 130)
			end
		else
			mogButton.Visible = false
		end
		task.wait(0.2)
	end
end)

mogButton.Activated:Connect(tryMog)
UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if not gameProcessed and input.KeyCode == Enum.KeyCode.G then
		tryMog()
	end
end)
