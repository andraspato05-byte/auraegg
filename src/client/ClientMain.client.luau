--[[
	STEAL THE AURA EGG - client

	The GUI itself is saved in the place (StarterGui.AuraEggHud, generated by
	tools/generate_gui.py), so you can see and restyle it in Studio. This
	script finds its parts by name and makes them work:
	  - HUD: cash, income per second, Speed, carry banner, how-to-play tips
	  - notification toasts sent by the server
	  - the Robux SHOP
	  - the AURA STORM event banner, countdown and lightning flashes
	  - shows "Steal" only on other people's eggs and "Sell" only on yours
	  - rainbow colours for Secret eggs, bat knockback, moving treadmill belts
]]

local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer
local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local remotes = ReplicatedStorage:WaitForChild("Remotes")
local notifyEvent = remotes:WaitForChild("Notify")
local knockbackEvent = remotes:WaitForChild("Knockback")
local startEventRemote = remotes:WaitForChild("StartEvent")
local mogRemote = remotes:WaitForChild("Mog")

local hud = player:WaitForChild("PlayerGui"):WaitForChild("AuraEggHud")

local cashPanel = hud:WaitForChild("CashPanel")
local cashLabel = cashPanel:WaitForChild("Cash")
local incomeLabel = cashPanel:WaitForChild("Income")
local speedLabel = cashPanel:WaitForChild("Speed")
local sizeLabel = cashPanel:WaitForChild("Size")
local notifyHolder = hud:WaitForChild("Notifications")
local carryBanner = hud:WaitForChild("CarryBanner")
local tips = hud:WaitForChild("HowToPlay")
local shopButton = hud:WaitForChild("ShopButton")
local shopPanel = hud:WaitForChild("ShopPanel")
local eventBanner = hud:WaitForChild("EventBanner")
local stormTestButton = hud:WaitForChild("StormTestButton")
local mogButton = hud:WaitForChild("MogButton")

------------------------------------------------------------------------------
-- How to play tips (fade out after a while)
------------------------------------------------------------------------------

task.delay(30, function()
	local fade = TweenService:Create(tips, TweenInfo.new(1.5), { TextTransparency = 1, BackgroundTransparency = 1 })
	fade:Play()
	fade.Completed:Wait()
	tips.Visible = false
end)

------------------------------------------------------------------------------
-- Cash / income / speed / carrying
------------------------------------------------------------------------------

local function refreshIncome()
	local income = player:GetAttribute("Income") or 0
	incomeLabel.Text = "+" .. Config.FormatCash(income) .. "/s"
end

local function refreshCarry()
	local carrying = player:GetAttribute("CarryingEgg")
	if type(carrying) == "string" and carrying ~= "" then
		carryBanner.Text = "Carrying " .. carrying .. "! Run back to your base!"
		carryBanner.Visible = true
	else
		carryBanner.Visible = false
	end
end

player:GetAttributeChangedSignal("Income"):Connect(refreshIncome)
player:GetAttributeChangedSignal("CarryingEgg"):Connect(refreshCarry)
refreshIncome()
refreshCarry()

task.spawn(function()
	local leaderstats = player:WaitForChild("leaderstats")

	local cash = leaderstats:WaitForChild("Cash")
	local function refreshCash()
		cashLabel.Text = Config.FormatCash(cash.Value)
	end
	cash.Changed:Connect(refreshCash)
	refreshCash()

	local speed = leaderstats:WaitForChild("Speed")
	local function refreshSpeed()
		local walk = Config.GetWalkSpeed(speed.Value)
		speedLabel.Text = "Speed " .. speed.Value .. "  (walk " .. string.format("%.1f", walk) .. ")"
	end
	speed.Changed:Connect(refreshSpeed)
	refreshSpeed()

	local size = leaderstats:WaitForChild("Size")
	local function refreshSize()
		sizeLabel.Text = "Size " .. size.Value .. "%"
	end
	size.Changed:Connect(refreshSize)
	refreshSize()
end)

------------------------------------------------------------------------------
-- Notifications
------------------------------------------------------------------------------

local notifyCount = 0
local MAX_NOTIFICATIONS = 5

local function showNotification(text, color)
	notifyCount += 1
	local label = Instance.new("TextLabel")
	label.Name = "Notification"
	label.LayoutOrder = notifyCount
	label.Size = UDim2.new(1, 0, 0, 32)
	label.BackgroundColor3 = Color3.fromRGB(20, 15, 35)
	label.BackgroundTransparency = 0.3
	label.BorderSizePixel = 0
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.Text = text
	label.TextColor3 = color
	label.TextStrokeTransparency = 0.3

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 8)
	corner.Parent = label

	local sizeLimit = Instance.new("UITextSizeConstraint")
	sizeLimit.MaxTextSize = 22
	sizeLimit.Parent = label

	label.Parent = notifyHolder

	-- keep only the newest few on screen
	local labels = {}
	for _, child in notifyHolder:GetChildren() do
		if child:IsA("TextLabel") then
			table.insert(labels, child)
		end
	end
	table.sort(labels, function(a, b)
		return a.LayoutOrder < b.LayoutOrder
	end)
	for index = 1, #labels - MAX_NOTIFICATIONS do
		labels[index]:Destroy()
	end

	task.delay(4, function()
		if label.Parent then
			local fade = TweenService:Create(label, TweenInfo.new(0.6), {
				TextTransparency = 1,
				TextStrokeTransparency = 1,
				BackgroundTransparency = 1,
			})
			fade:Play()
			fade.Completed:Wait()
			label:Destroy()
		end
	end)
end

notifyEvent.OnClientEvent:Connect(function(text, color)
	if type(text) ~= "string" then
		return
	end
	if typeof(color) ~= "Color3" then
		color = Color3.fromRGB(255, 255, 255)
	end
	showNotification(text, color)
end)

------------------------------------------------------------------------------
-- Robux shop
------------------------------------------------------------------------------

local shopItems = shopPanel:WaitForChild("Items")
local headerTemplate = shopPanel:WaitForChild("HeaderTemplate")
local itemTemplate = shopPanel:WaitForChild("ItemTemplate")
local shopScale = shopPanel:WaitForChild("Scale")
local closeButton = shopPanel:WaitForChild("Close")

local itemCount = 0

local function addSectionHeader(text)
	itemCount += 1
	local header = headerTemplate:Clone()
	header.Name = "Header" .. itemCount
	header.Text = text
	header.LayoutOrder = itemCount
	header.Visible = true
	header.Parent = shopItems
end

-- Builds one shop row from the template. Returns the buy button.
local function addItem(name, description, infoType, id)
	itemCount += 1
	local row = itemTemplate:Clone()
	row.Name = name
	row.LayoutOrder = itemCount
	row.Visible = true
	row:WaitForChild("ItemName").Text = name
	row:WaitForChild("Description").Text = description
	local buy = row:WaitForChild("Buy")
	row.Parent = shopItems

	if id == 0 then
		buy.Text = "Not set up"
		buy.BackgroundColor3 = Color3.fromRGB(90, 90, 100)
	else
		buy.Text = "BUY"
		-- show the real Robux price
		task.spawn(function()
			local ok, info = pcall(function()
				return MarketplaceService:GetProductInfoAsync(id, infoType)
			end)
			if ok and type(info) == "table" and type(info.PriceInRobux) == "number" and buy.Text == "BUY" then
				buy.Text = "R$ " .. info.PriceInRobux
			end
		end)
	end
	return buy
end

addSectionHeader("GAME PASSES (forever)")
for _, pass in Config.GamePasses do
	local buy = addItem(pass.Name, pass.Description, Enum.InfoType.GamePass, pass.Id)
	local attribute = "Pass_" .. pass.Key
	local function refreshOwned()
		if player:GetAttribute(attribute) == true then
			buy.Text = "OWNED"
			buy.BackgroundColor3 = Color3.fromRGB(110, 80, 160)
		end
	end
	player:GetAttributeChangedSignal(attribute):Connect(refreshOwned)
	refreshOwned()

	buy.Activated:Connect(function()
		if pass.Id == 0 then
			showNotification("This pass isn't set up yet (missing ID in Config).", Color3.fromRGB(255, 150, 40))
		elseif player:GetAttribute(attribute) ~= true then
			MarketplaceService:PromptGamePassPurchase(player, pass.Id)
		end
	end)
end

addSectionHeader("ITEMS")
for _, product in Config.Products do
	local description = ""
	if product.Cash then
		description = "Get " .. Config.FormatCash(product.Cash) .. " cash instantly"
	elseif product.LuckyEgg then
		description = "A random Legendary, Mythic or Secret egg!"
	end
	local buy = addItem(product.Name, description, Enum.InfoType.Product, product.Id)
	buy.Activated:Connect(function()
		if product.Id == 0 then
			showNotification("This item isn't set up yet (missing ID in Config).", Color3.fromRGB(255, 150, 40))
		else
			MarketplaceService:PromptProductPurchase(player, product.Id)
		end
	end)
end

local function fitShopToScreen()
	local camera = workspace.CurrentCamera
	if camera then
		local viewport = camera.ViewportSize
		shopScale.Scale = math.clamp(math.min(viewport.X / 480, viewport.Y / 520), 0.5, 1)
	end
end

shopButton.Activated:Connect(function()
	fitShopToScreen()
	shopPanel.Visible = not shopPanel.Visible
end)
closeButton.Activated:Connect(function()
	shopPanel.Visible = false
end)

------------------------------------------------------------------------------
-- AURA STORM event: banner, countdown and lightning
------------------------------------------------------------------------------

local eventTitle = eventBanner:WaitForChild("Title")
local eventTimer = eventBanner:WaitForChild("Timer")

local function formatTime(seconds)
	local s = math.max(0, math.floor(seconds))
	return string.format("%d:%02d", s // 60, s % 60)
end

local function refreshEventBanner()
	local name = workspace:GetAttribute("EventName") or "AURA STORM"
	local nowTime = workspace:GetServerTimeNow()
	if workspace:GetAttribute("EventActive") == true then
		eventTitle.Text = name .. "!"
		eventTitle.TextColor3 = Color3.fromRGB(255, 230, 120)
		eventTimer.Text = "Ends in " .. formatTime((workspace:GetAttribute("EventEndsAt") or nowTime) - nowTime)
			.. "  |  Storm eggs x3!"
	else
		local nextAt = workspace:GetAttribute("NextEventAt")
		eventTitle.Text = "NEXT EVENT: " .. name
		eventTitle.TextColor3 = Color3.fromRGB(150, 220, 255)
		eventTimer.Text = nextAt and ("Starts in " .. formatTime(nextAt - nowTime)) or "--:--"
	end
end

task.spawn(function()
	while true do
		refreshEventBanner()
		task.wait(0.5)
	end
end)

-- Lightning flashes during the storm (only on this screen)
local flash = Instance.new("ColorCorrectionEffect")
flash.Name = "LightningFlash"
flash.Brightness = 0
flash.Parent = Lighting

task.spawn(function()
	local rng = Random.new()
	while true do
		task.wait(rng:NextNumber(2, 6))
		if workspace:GetAttribute("EventActive") == true then
			flash.Brightness = 0.6
			TweenService:Create(flash, TweenInfo.new(0.35), { Brightness = 0 }):Play()
			if rng:NextNumber() < 0.4 then
				task.wait(0.15)
				flash.Brightness = 0.4
				TweenService:Create(flash, TweenInfo.new(0.3), { Brightness = 0 }):Play()
			end
		end
	end
end)

-- Studio-only button to start a storm right away for testing
stormTestButton.Visible = RunService:IsStudio()
stormTestButton.Activated:Connect(function()
	startEventRemote:FireServer()
end)

------------------------------------------------------------------------------
-- Prompt filtering: Steal on other people's eggs, Sell on your own
------------------------------------------------------------------------------

local function applyPrompt(prompt)
	local kind = prompt:GetAttribute("Kind")
	if kind == nil then
		return
	end
	local isMine = prompt:GetAttribute("OwnerUserId") == player.UserId
	if kind == "Steal" then
		prompt.Enabled = not isMine
	elseif kind == "Sell" or kind == "Upgrade" then
		prompt.Enabled = isMine
	end
end

local function watchPrompt(instance)
	if instance:IsA("ProximityPrompt") then
		applyPrompt(instance)
		instance:GetAttributeChangedSignal("OwnerUserId"):Connect(function()
			applyPrompt(instance)
		end)
	end
end

workspace.DescendantAdded:Connect(watchPrompt)
for _, descendant in workspace:GetDescendants() do
	watchPrompt(descendant)
end

