--[[
	MapBuilder
	The map itself is saved in the place file (Workspace.Map and
	Workspace.Plots, generated by tools/generate_map.py), so you can see and
	edit it in Studio. This module finds the parts the game needs, adds the
	floating text labels, and hands everything to the other services.

	If you edit the map in Studio, keep these names:
	  Workspace.Map.ConveyorBelt, Workspace.Map.AuraEggMachine, Workspace.Map.TitleAnchor
	  Workspace.Plots.Plot1 .. Plot8, each containing:
	    Origin, LockBarrier, SignAnchor, LockPad, UpgradeTerminal, Eggs,
	    Pedestal1 .. Pedestal10, PedestalRim1 .. PedestalRim10, CashPad1 .. CashPad10
	  Treadmill models (attribute Tier = 1..4) with a part named Belt
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

local MapBuilder = {}

local PLOT_HALF = 28

local function need(parent, name)
	local child = parent:FindFirstChild(name)
	if not child then
		error(
			string.format("[StealTheAuraEgg] Map is missing '%s' inside %s. Did it get renamed or deleted?", name, parent:GetFullName()),
			2
		)
	end
	return child
end

-- Floating text attached to a part. size is in studs.
local function newBillboard(adornee, sizeX, sizeY, offset, text, color, maxDistance)
	local gui = Instance.new("BillboardGui")
	gui.Name = "Label"
	gui.Adornee = adornee
	gui.Size = UDim2.new(sizeX, 0, sizeY, 0)
	gui.StudsOffset = offset
	gui.AlwaysOnTop = false
	gui.LightInfluence = 0
	gui.MaxDistance = maxDistance or 150

	local label = Instance.new("TextLabel")
	label.Name = "Text"
	label.BackgroundTransparency = 1
	label.Size = UDim2.new(1, 0, 1, 0)
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.Text = text
	label.TextColor3 = color
	label.TextStrokeTransparency = 0
	label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
	label.Parent = gui

	gui.Parent = adornee
	return label
end

MapBuilder.NewBillboard = newBillboard

local function loadPlot(index, plotsFolder)
	local model = need(plotsFolder, "Plot" .. index)
	local origin = need(model, "Origin")
	local plotCFrame = origin.CFrame

	local slots = {}
	for slotIndex = 1, Config.SlotsPerPlot do
		local pedestal = need(model, "Pedestal" .. slotIndex)
		local pad = need(model, "CashPad" .. slotIndex)
		local rim = need(model, "PedestalRim" .. slotIndex)
		local pedestalLocal = plotCFrame:PointToObjectSpace(pedestal.Position)
		slots[slotIndex] = {
			Pedestal = pedestal,
			-- top centre of the pedestal, in the plot's orientation
			EggBaseCFrame = plotCFrame * CFrame.new(pedestalLocal.X, pedestalLocal.Y + pedestal.Size.Y / 2, pedestalLocal.Z),
			PadLocal = plotCFrame:PointToObjectSpace(pad.Position),
			PadLabel = newBillboard(pad, 5, 1.4, Vector3.new(0, 2.2, 0), "", Color3.fromRGB(120, 255, 140), 60),
			Pad = pad,
			PadColor = pad.Color,
			Rim = rim,
			RimColor = rim.Color,
		}
	end

	local lockPad = need(model, "LockPad")
	local upgradeTerminal = need(model, "UpgradeTerminal")
	local eggsFolder = model:FindFirstChild("Eggs")
	if not eggsFolder then
		eggsFolder = Instance.new("Folder")
		eggsFolder.Name = "Eggs"
		eggsFolder.Parent = model
	end

	model:SetAttribute("PlotIndex", index)
	model:SetAttribute("OwnerUserId", 0)
	model:SetAttribute("OwnerName", "")

	return {
		Index = index,
		Model = model,
		CFrame = plotCFrame,
		HalfSize = PLOT_HALF,
		Barrier = need(model, "LockBarrier"),
		SignLabel = newBillboard(need(model, "SignAnchor"), 22, 3.5, Vector3.new(), "Empty Base", Color3.fromRGB(255, 255, 255), 250),
		Slots = slots,
		LockPadLocal = plotCFrame:PointToObjectSpace(lockPad.Position),
		LockLabel = newBillboard(lockPad, 8, 1.6, Vector3.new(0, 2.5, 0), "", Color3.fromRGB(255, 255, 255), 80),
		EggsFolder = eggsFolder,
		UpgradeTerminal = upgradeTerminal,
		UpgradeLabel = newBillboard(upgradeTerminal, 12, 2.6, Vector3.new(0, 4, 0), "", Color3.fromRGB(255, 220, 90), 60),
		UpgradePrompt = nil, -- created by PlotService
		SpawnCFrame = plotCFrame * CFrame.new(0, 4, 6), -- facing the entrance
		EjectCFrame = plotCFrame * CFrame.new(0, 4, -38), -- just outside the entrance, on the walkway
	}
end

function MapBuilder.Build()
	local map = need(workspace, "Map")
	local plotsFolder = need(workspace, "Plots")

	local plots = {}
	for index = 1, Config.MaxPlots do
		plots[index] = loadPlot(index, plotsFolder)
	end

	local belt = need(map, "ConveyorBelt")
	newBillboard(need(map, "AuraEggMachine"), 26, 5, Vector3.new(0, 16, 0), "AURA EGG MACHINE", Color3.fromRGB(230, 180, 255), 400)
	newBillboard(need(map, "TitleAnchor"), 80, 12, Vector3.new(), string.upper(Config.GameName), Color3.fromRGB(200, 140, 255), 800)

	local treadmills = {}
	for _, descendant in map:GetDescendants() do
		if descendant:IsA("Model") and descendant.Name == "Treadmill" and descendant:GetAttribute("Tier") then
			table.insert(treadmills, descendant)
		elseif descendant:IsA("BasePart") and descendant.Name == "GymSignAnchor" then
			newBillboard(descendant, 34, 6, Vector3.new(), "TREADMILL GYM", Color3.fromRGB(120, 220, 255), 400)
		end
	end

	local halfLength = belt.Size.X / 2
	return {
		Plots = plots,
		Treadmills = treadmills,
		Belt = {
			StartX = belt.Position.X - halfLength + 3,
			EndX = belt.Position.X + halfLength - 3,
			Z = belt.Position.Z,
			SurfaceY = belt.Position.Y + belt.Size.Y / 2,
		},
	}
end

return MapBuilder
